# ─────────────────────────────────────────────
# Environment Configuration
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/healthai_db

# ── Zitadel Identity Provider ─────────────────
# Your Zitadel instance URL
ZITADEL_DOMAIN=http://mspr-zitadel-a7c405-158-220-101-254.traefik.me

# Issuer claim — must exactly match the Zitadel issuer (see URLs tab)
JWT_ISSUER=http://mspr-zitadel-a7c405-158-220-101-254.traefik.me

# Audience claim — the Project ID of the Zitadel project containing the
# frontend app (all tokens issued for apps of that project carry it)
JWT_AUDIENCE=375235925845737475

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000

# ── Rate Limiting ─────────────────────────────
# Time window in milliseconds (default: 1 minute)
THROTTLE_TTL=60000
# Max requests per window per IP
THROTTLE_LIMIT=100

# ── Development only ──────────────────────────
DEV_DEFAULT_USER_EMAIL=dev@healthai.local
DEV_DEFAULT_USER_PASSWORD=ChangeMe123!
