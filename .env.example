# Environment Configuration
NODE_ENV=development

# Server
PORT=3001

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/healthai_db

# Zitadel Identity Provider
# Your Zitadel instance URL (e.g. https://your-instance.zitadel.cloud)
ZITADEL_DOMAIN=https://your-instance.zitadel.cloud

# JWT Claims
# Must match your Zitadel project configuration exactly.
# JWT_ISSUER is typically your ZITADEL_DOMAIN.
# JWT_AUDIENCE is the API resource server audience configured in Zitadel.
JWT_ISSUER=https://your-instance.zitadel.cloud
JWT_AUDIENCE=your-api-resource-server-audience
JWT_EXPIRES_IN=3600s

# API Security
# API key for securing endpoints (minimum 32 characters)
API_KEY=your-api-key-minimum-32-characters-required-here

# Frontend Configuration
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000
# Frontend client ID for validation (minimum 8 characters)
FRONTEND_CLIENT_ID=frontend-client-id-min-8-chars

# Rate Limiting
# Time window in milliseconds (default: 60000 = 1 minute)
THROTTLE_TTL=60000
# Max requests per window per IP (default: 100)
THROTTLE_LIMIT=100

# Development Account (Development only - not used in production)
DEV_DEFAULT_USER_EMAIL=ngeMe123!dev-account
DEV_DEFAULT_USER_PASSWORD=ChangeMe123!dev-account
